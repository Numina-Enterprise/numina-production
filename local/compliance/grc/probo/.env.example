# Copy to .env (gitignored) and fill with locally generated values. Never commit .env.
# Generate each secret with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PROBO_PG_PASSWORD=
PROBO_S3_SECRET=
PROBOD_ENCRYPTION_KEY=
PROBOD_AUTH_COOKIE_SECRET=
PROBOD_AUTH_PASSWORD_PEPPER=
PROBOD_TRUST_AUTH_TOKEN_SECRET=
# RSA key used by Probo to sign its own OAuth2 tokens (local only; unrelated to Sam's Ed25519 sign-off key):
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 > oauth2_signing_key.pem  (keep outside the repo)
# then paste as one double-quoted line with \n escapes.
PROBOD_OAUTH2_SERVER_SIGNING_KEY=
