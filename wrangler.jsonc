{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "numina-production",
  "main": "./dist/server/index.js",
  "compatibility_date": "2026-09-18",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    { "pattern": "numinalabs.xyz/*", "zone_name": "numinalabs.xyz" },
    { "pattern": "www.numinalabs.xyz/*", "zone_name": "numinalabs.xyz" }
  ],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": false
  }
}
