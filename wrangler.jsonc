{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "numina-production",
  "account_id": "3c1fd59ef2ef67f750b4bc23e656d722",
  "keep_vars": true,
  "unsafe": {
    "metadata": {
      "keep_bindings": [
        "plain_text",
        "json",
        "secret_text",
        "secret_key",
        "d1",
        "r2_bucket"
      ]
    }
  },
  "main": "./dist/server/index.js",
  "compatibility_date": "2026-09-18",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "numinalabs.xyz/*",
      "zone_name": "numinalabs.xyz"
    },
    {
      "pattern": "www.numinalabs.xyz/*",
      "zone_name": "numinalabs.xyz"
    }
  ],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/.well-known/*",
      "/v1/*",
      "/v2/*",
      "/v3/*",
      "/v4/*",
      "/v5/*",
      "/readyz",
      "/control-room*",
      "/pricing*",
      "/platform*",
      "/favicon.ico",
      "/robots.txt",
      "/downloads",
      "/downloads/*",
      "/mcp",
      "/mcp/*"
    ],
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash"
  }
}
