{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://numinalabs.xyz/schemas/procurement-evidence-v1.schema.json",
  "title": "Request-bound signed procurement evidence",
  "description": "Projection only. Signatures require independently configured server-owned Ed25519 trust anchors. Booleans and historical assertions never grant permission.",
  "type": "object",
  "required": [
    "keyId",
    "payload",
    "signature"
  ],
  "additionalProperties": false,
  "properties": {
    "keyId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._-]*$"
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{86}$"
    },
    "payload": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "schema",
            "type",
            "evidenceId",
            "bindingHash",
            "issuedAt",
            "expiresAt"
          ],
          "additionalProperties": false,
          "properties": {
            "schema": {
              "const": "numina.procurement-evidence.v1"
            },
            "type": {
              "const": "approval"
            },
            "evidenceId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._-]*$"
            },
            "bindingHash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "issuedAt": {
              "type": "integer",
              "minimum": 0
            },
            "expiresAt": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        {
          "type": "object",
          "required": [
            "schema",
            "type",
            "evidenceId",
            "bindingHash",
            "issuedAt",
            "expiresAt",
            "delegateKeyId"
          ],
          "additionalProperties": false,
          "properties": {
            "schema": {
              "const": "numina.procurement-evidence.v1"
            },
            "type": {
              "const": "delegation"
            },
            "evidenceId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._-]*$"
            },
            "bindingHash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "issuedAt": {
              "type": "integer",
              "minimum": 0
            },
            "expiresAt": {
              "type": "integer",
              "minimum": 1
            },
            "delegateKeyId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._-]*$"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "schema",
            "type",
            "evidenceId",
            "bindingHash",
            "issuedAt",
            "expiresAt",
            "reservationId",
            "state"
          ],
          "additionalProperties": false,
          "properties": {
            "schema": {
              "const": "numina.procurement-evidence.v1"
            },
            "type": {
              "const": "budget"
            },
            "evidenceId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._-]*$"
            },
            "bindingHash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "issuedAt": {
              "type": "integer",
              "minimum": 0
            },
            "expiresAt": {
              "type": "integer",
              "minimum": 1
            },
            "reservationId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._-]*$"
            },
            "state": {
              "const": "RESERVED"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "schema",
            "type",
            "evidenceId",
            "bindingHash",
            "issuedAt",
            "expiresAt",
            "capability"
          ],
          "additionalProperties": false,
          "properties": {
            "schema": {
              "const": "numina.procurement-evidence.v1"
            },
            "type": {
              "const": "provider_access"
            },
            "evidenceId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._-]*$"
            },
            "bindingHash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "issuedAt": {
              "type": "integer",
              "minimum": 0
            },
            "expiresAt": {
              "type": "integer",
              "minimum": 1
            },
            "capability": {
              "const": "MANUAL_DIRECT_PARTNERSHIP"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "schema",
            "type",
            "evidenceId",
            "bindingHash",
            "issuedAt",
            "expiresAt",
            "providerReceiptId",
            "idempotencyKey",
            "status",
            "occurredAt"
          ],
          "additionalProperties": false,
          "properties": {
            "schema": {
              "const": "numina.procurement-evidence.v1"
            },
            "type": {
              "const": "provider_receipt"
            },
            "evidenceId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._-]*$"
            },
            "bindingHash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "issuedAt": {
              "type": "integer",
              "minimum": 0
            },
            "expiresAt": {
              "type": "integer",
              "minimum": 1
            },
            "providerReceiptId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._-]*$"
            },
            "idempotencyKey": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._-]*$"
            },
            "status": {
              "enum": [
                "SETTLED",
                "PENDING",
                "FAILED",
                "REVERSED"
              ]
            },
            "occurredAt": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      ]
    }
  }
}
