@@ -0,0 +1,47 @@
+import {controlError} from '../control.js';
+import {amountText,requirePositiveAmount} from './amounts.js';
+
+// Mirrors PREPARE_BANK_TRANSACTION fields from src/native-treasury-model.js:
+// amountMinor, currency USD, destination reference, submission_performed false.
+// This module does not append a journal event or contact a bank.
+const REFERENCE=/^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$/;
+const DIGEST=/^sha256:[a-f0-9]{64}$/;
+
+export function prepareQualifiedBankEscrow({amountMinor,currency,destinationReference,institutionReference,qualificationEvidenceDigest=null}){
+  const amount=requirePositiveAmount(amountMinor,'INVALID_TRANSACTION_AMOUNT');
+  if(currency!=='USD')controlError('INVALID_TRANSACTION_REFERENCE',400);
+  if(typeof destinationReference!=='string'||!REFERENCE.test(destinationReference))controlError('INVALID_TRANSACTION_REFERENCE',400);
+  if(typeof institutionReference!=='string'||!REFERENCE.test(institutionReference))controlError('INVALID_INSTITUTION_REFERENCE',400);
+  if(qualificationEvidenceDigest!==null&&(typeof qualificationEvidenceDigest!=='string'||!DIGEST.test(qualificationEvidenceDigest)))controlError('INVALID_QUALIFICATION_DIGEST',400);
+  const prepared=Object.freeze({
+    schema:'numina.treasury.qualified-bank-escrow.preparation.v1',
+    module:'qualified-bank-escrow',
+    kind:'bank_transaction_request',
+    status:'PREPARED',
+    currency:'USD',
+    amountMinor:amountText(amount),
+    escrowedAmountMinor:amountText(amount),
+    releasedAmountMinor:'0',
+    destinationReference,
+    institutionReference,
+    qualificationEvidenceDigest,
+    qualificationVerified:false,
+    fundsMoved:false,
+    submissionPerformed:false,
+    executionPerformed:false,
+    receipt:null
+  });
+  assertEscrowConserved(prepared);
+  return prepared;
+}
+
+export function assertEscrowConserved(prepared){
+  const escrowed=BigInt(prepared.escrowedAmountMinor);
+  const released=BigInt(prepared.releasedAmountMinor);
+  if(escrowed<0n||released<0n||escrowed+released!==BigInt(prepared.amountMinor))controlError('ESCROW_NOT_CONSERVED',409);
+  return true;
+}
+
+export function releaseQualifiedBankEscrow(){
+  controlError('BANK_RELEASE_NOT_WIRED',409);
+}
diff --git a/src/treasury-modules/revenue-splitter.js b/src/treasury-modules/revenue-splitter.js
new file mode 100644
index 00000000..a8671b5a
--- /dev/null
+++ b/src/treasury-modules/revenue-splitter.js
@@ -0,0 +1,55 @@
+import {controlError} from '../control.js';
+import {amountText,requirePositiveAmount} from './amounts.js';
+
+// Reference copy: numina-smart-contracts/contracts/NuminaRevenueSplitter.sol
+// SHA-256 685d081ff1b4485a112eeb926f4e0edff71b419879b655d8b7ceb31a8d22f000 (2122 bytes).
+// The reference receive() calls distributeRevenue(), which forwards with transfer.
+// Weights are 70/20/10. Integer-division remainder is assigned to protocol.
+export const REVENUE_SPLITTER_REFERENCE=Object.freeze({
+  label:'reference-original',
+  path:'numina-smart-contracts/contracts/NuminaRevenueSplitter.sol',
+  sha256:'685d081ff1b4485a112eeb926f4e0edff71b419879b655d8b7ceb31a8d22f000',
+  bytes:2122,
+  reserveBps:7000,stakingBps:2000,protocolBps:1000,totalBps:10000,
+  knownIssues:Object.freeze([
+    'receive() immediately calls distributeRevenue()',
+    'distributeRevenue() forwards native value with transfer',
+    '70/20/10 integer division; remainder is assigned to protocol'
+  ])
+});
+
+const RESERVE_BPS=7000n,STAKING_BPS=2000n,PROTOCOL_BPS=1000n,TOTAL_BPS=10000n;
+
+export function splitRevenueAmount(amount){
+  const total=requirePositiveAmount(amount,'ZERO_REVENUE');
+  const reserve=(total*RESERVE_BPS)/TOTAL_BPS;
+  const staking=(total*STAKING_BPS)/TOTAL_BPS;
+  const protocol=total-reserve-staking;
+  if(reserve+staking+protocol!==total)controlError('SPLIT_NOT_CONSERVED',409);
+  if(RESERVE_BPS+STAKING_BPS+PROTOCOL_BPS!==TOTAL_BPS)controlError('BPS_NOT_CONSERVED',409);
+  return Object.freeze({
+    amount:amountText(total),
+    reserve:amountText(reserve),
+    staking:amountText(staking),
+    protocol:amountText(protocol)
+  });
+}
+
+// Preparation only. Inbound value is accounted and is not forwarded.
+export function prepareRevenueDistribution(amount){
+  const shares=splitRevenueAmount(amount);
+  return Object.freeze({
+    schema:'numina.treasury.revenue-splitter.preparation.v1',
+    module:'revenue-splitter',
+    status:'PREPARED',
+    reference:REVENUE_SPLITTER_REFERENCE.path,
+    executionPerformed:false,
+    valueForwarded:false,
+    submissionPerformed:false,
+    shares
+  });
+}
+
+export function executeRevenueDistribution(){
+  controlError('REVENUE_DISTRIBUTION_EXECUTION_NOT_WIRED',409);
+}
diff --git a/src/treasury-modules/solvency-ledger.js b/src/treasury-modules/solvency-ledger.js
new file mode 100644
index 00000000..58af7e06
--- /dev/null
+++ b/src/treasury-modules/solvency-ledger.js
@@ -0,0 +1,58 @@
+import {controlError} from '../control.js';
+import {amountText,requireDecimals,requirePositiveAmount} from './amounts.js';
+
+// Integer ledger of recorded base units. It does not claim external solvency or add across decimal variants.
+const COMPONENT=/^[a-z0-9][a-z0-9-]{0,63}$/;
+
+export function createSolvencyLedger(){
+  return Object.freeze({
+    schema:'numina.treasury.solvency-ledger.v1',
+    module:'solvency-ledger',
+    entries:Object.freeze([]),
+    externallySolvent:false,
+    executionPerformed:false
+  });
+}
+
+export function postSolvencyEntry(ledger,entry){
+  if(!ledger||ledger.schema!=='numina.treasury.solvency-ledger.v1'||ledger.executionPerformed!==false)controlError('SOLVENCY_LEDGER_INVALID',409);
+  if(!entry||typeof entry.id!=='string'||!COMPONENT.test(entry.id)||typeof entry.component!=='string'||!COMPONENT.test(entry.component))controlError('INVALID_SOLVENCY_ENTRY',400);
+  if(entry.direction!=='asset'&&entry.direction!=='liability')controlError('INVALID_SOLVENCY_ENTRY',400);
+  if(ledger.entries.some(item=>item.id===entry.id))controlError('DUPLICATE_SOLVENCY_ENTRY',409);
+  const decimals=requireDecimals(entry.decimals);
+  const baseUnits=requirePositiveAmount(entry.baseUnits,'INVALID_AMOUNT');
+  const posted=Object.freeze({id:entry.id,component:entry.component,decimals,direction:entry.direction,baseUnits:amountText(baseUnits)});
+  return Object.freeze({
+    ...ledger,
+    entries:Object.freeze([...ledger.entries,posted]),
+    externallySolvent:false,
+    executionPerformed:false
+  });
+}
+
+export function solvencyResidual(ledger,decimals){
+  requireDecimals(decimals);
+  let assets=0n,liabilities=0n;
+  for(const entry of ledger.entries){
+    if(entry.decimals!==decimals)continue;
+    const amount=BigInt(entry.baseUnits);
+    if(entry.direction==='asset')assets+=amount;
+    else liabilities+=amount;
+  }
+  return Object.freeze({
+    decimals,
+    assets:amountText(assets),
+    liabilities:amountText(liabilities),
+    residual:amountText(assets>=liabilities?assets-liabilities:liabilities-assets),
+    residualSign:assets>=liabilities?'non-negative':'deficit',
+    externallySolvent:false,
+    executionPerformed:false
+  });
+}
+
+export function combinedSolvency(ledger){
+  const decimals=new Set(ledger.entries.map(entry=>entry.decimals));
+  if(decimals.size>1)controlError('DECIMAL_VARIANTS_NOT_ADDITIVE',409);
+  const only=[...decimals][0]??0;
+  return solvencyResidual(ledger,only);
+}
diff --git a/src/treasury-modules/treasury-reserve.js b/src/treasury-modules/treasury-reserve.js
new file mode 100644
index 00000000..8a5b6f58
--- /dev/null
+++ b/src/treasury-modules/treasury-reserve.js
@@ -0,0 +1,86 @@
+import {controlError} from '../control.js';
+import {isZeroAddress,requireAddress,requirePositiveAmount} from './amounts.js';
+
+const HEX32=/^0x[0-9a-fA-F]{64}$/;
+
+// Reference copy: numina-smart-contracts/contracts/NuminaTreasuryReserve.sol
+// SHA-256 2f1c5551b51042882bf445d96a61e5a4d38fbe491fc358b1c676a488871192ff (4138 bytes).
+// This module does not replace that file and does not rescale any token.
+export const TREASURY_RESERVE_REFERENCE=Object.freeze({
+  label:'reference-original',
+  path:'numina-smart-contracts/contracts/NuminaTreasuryReserve.sol',
+  sha256:'2f1c5551b51042882bf445d96a61e5a4d38fbe491fc358b1c676a488871192ff',
+  bytes:4138,
+  decimals:6,
+  capExpression:'1_500_000_000_000_000 * 10**6',
+  baseUnitCap:'1500000000000000000000',
+  knownIssues:Object.freeze([
+    'Reference treasury uses 6 decimals and a 1.5-quadrillion cap; the receipt-bound on-chain NUSD source uses 18 decimals',
+    'guardian is stored and unused',
+    'executeSettlement accepts any nonzero proofHash and does not check a signature',
+    'transferFrom does not reject a zero address'
+  ])
+});
+
+// Unselected. The receipt-bound source and the runtime candidate stay separate files.
+export const NUSD_DECIMAL_VARIANTS=Object.freeze([
+  Object.freeze({id:'vengeance-treasury-reserve-6d',decimals:6,baseUnits:'1500000000000000000000',sha256:TREASURY_RESERVE_REFERENCE.sha256,role:'reference-original'}),
+  Object.freeze({id:'receipt-bound-numina-usd-18d',decimals:18,baseUnits:'1500000000000000000000000000000000',sha256:'08fdd4e87e7ca336edc3cf7958a035feca73e4275968bee04d30d5d217e18238',role:'receipt-bound-source',receipt:'docs/nusd/deployment-receipt.json'}),
+  Object.freeze({id:'runtime-candidate-numina-usd-6d',decimals:6,sha256:'c2aa2975d3a5c6fb1fe75ee86e3851e7a13ef1c21bfe06f8fa2a5a1558e52510',role:'runtime-candidate',path:'runtime/nusd/contracts/NuminaUSD.sol'})
+]);
+export const SELECTED_RUNTIME_VARIANT=null;
+
+export function prepareReserveSettlement({owner,guardian,recipient,amount,proofHash,debitFrom,reserveAddress}){
+  requireAddress(owner,'INVALID_OWNER');
+  requireAddress(guardian,'INVALID_GUARDIAN');
+  requireAddress(recipient,'INVALID_RECIPIENT');
+  requireAddress(debitFrom,'INVALID_DEBIT_ACCOUNT');
+  requireAddress(reserveAddress,'INVALID_RESERVE_ADDRESS');
+  if(isZeroAddress(guardian)||isZeroAddress(owner)||guardian.toLowerCase()===owner.toLowerCase())controlError('GUARDIAN_MUST_BE_DISTINCT',400);
+  if(isZeroAddress(recipient))controlError('INVALID_RECIPIENT',400);
+  if(isZeroAddress(reserveAddress))controlError('INVALID_RESERVE_ADDRESS',400);
+  const debit=debitFrom.toLowerCase();
+  if(debit!==owner.toLowerCase()&&debit!==reserveAddress.toLowerCase())controlError('INVALID_DEBIT_ACCOUNT',400);
+  requirePositiveAmount(amount,'ZERO_SETTLEMENT_AMOUNT');
+  if(typeof proofHash!=='string'||!HEX32.test(proofHash)||/^0x0{64}$/i.test(proofHash))controlError('INVALID_PROOF_HASH',400);
+  return Object.freeze({
+    schema:'numina.treasury.reserve.preparation.v1',
+    module:'treasury-reserve',
+    status:'PREPARED',
+    reference:TREASURY_RESERVE_REFERENCE.path,
+    decimals:TREASURY_RESERVE_REFERENCE.decimals,
+    selectedRuntimeVariant:SELECTED_RUNTIME_VARIANT,
+    executionPerformed:false,
+    balancesMoved:false,
+    proofHashAuthorizesExecution:false,
+    guardianUsed:true,
+    signatureVerificationPerformed:false,
+    owner,guardian,recipient,amount,proofHash,debitFrom,reserveAddress
+  });
+}
+
+export function prepareReserveTransferFrom({from,to,amount}){
+  requireAddress(from,'INVALID_ADDRESS');
+  requireAddress(to,'INVALID_ADDRESS');
+  if(isZeroAddress(from)||isZeroAddress(to))controlError('TRANSFER_TO_ZERO_ADDRESS',400);
+  requirePositiveAmount(amount);
+  return Object.freeze({status:'PREPARED',executionPerformed:false,balancesMoved:false,from,to,amount});
+}
+
+// A nonzero proofHash is not authorization. Present signatures are not checked here.
+export function authorizeReserveSettlement(preparation,signatures={}){
+  if(!preparation||preparation.status!=='PREPARED'||preparation.proofHashAuthorizesExecution!==false)controlError('SETTLEMENT_NOT_PREPARED',409);
+  const guardianSignature=signatures.guardianSignature??null;
+  const authoritySignature=signatures.authoritySignature??null;
+  if(!guardianSignature||!authoritySignature)controlError('PROOF_HASH_IS_NOT_A_SIGNATURE',409);
+  return Object.freeze({
+    status:'BLOCKED',
+    executionPerformed:false,
+    signatureVerificationPerformed:false,
+    reason:'SIGNATURE_VERIFICATION_NOT_PERFORMED'
+  });
+}
+
+export function rescaleReserveBaseUnits(){
+  controlError('DECIMAL_RESCALE_REFUSED',409);
+}
