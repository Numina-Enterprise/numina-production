  "curriculum": [
    {
      "id": "leveling",
      "competencies": [
        "memory",
        "planning",
        "sequencing",
        "recovery"
      ],
      "scenario": "Progress through staged challenges with limited resources",
      "completion_rule": "Demonstrate repeatable task execution against held-out scenarios"
    },
    {
      "id": "dungeons",
      "competencies": [
        "coordination",
        "role-specialization",
        "risk-assessment"
      ],
      "scenario": "Collaborative multi-agent dungeon-style encounters in original simulated environments",
      "completion_rule": "Complete objective with bounded resource spend and independently reviewed logs"
    },
    {
      "id": "guild-economy",
      "competencies": [
        "reconciliation",
        "budget-management",
        "decision-making"
      ],
      "scenario": "Allocate simulation credits with explicit resource constraints",
      "completion_rule": "Ledger conservation and no unauthorized real-money effects"
    },
    {
      "id": "raid-leadership",
      "competencies": [
        "communication",
        "delegation",
        "incident-response"
      ],
      "scenario": "Coordinate multiple rooms through staged faults and recovery paths",
      "completion_rule": "All decisions traceable; incidents escalated and replayed"
    }
  ],
  "teams": [
    {
      "id": "white",
      "assignment": "Diagnose configuration, connectivity, CI and recovery blockers"
    },
    {
      "id": "blue",
      "assignment": "Defensive security testing, evidence verification and remediation retest"
    },
    {
      "id": "green",
      "assignment": "Infrastructure operational checks, backups, service health and rollback readiness"
    },
    {
      "id": "red",
      "assignment": "Independent adversarial and security review without modifying production"
    },
    {
      "id": "gold",
      "assignment": "Release readiness coordination, evidence completeness, acceptance reconciliation and escalation to the owner; cannot sign, self-approve, deploy or move funds"
    },
    {
      "id": "gamma",
      "assignment": "Develop missing implementation and tests on isolated review branches; submit commits and receipts for independent review"
    }
  ],
