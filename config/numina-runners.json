{
  "schema": "numina.runner-policy.v2",
  "identity": "NUMINA",
  "runnerIdentity": "NUMINA",
  "hostingIdentity": "NUMINA",
  "allRunnersAreNumina": true,
  "selfHostedAllowed": false,
  "executionBackends": {
    "linux": {
      "numinaIdentity": "NUMINA",
      "provider": "github-hosted",
      "runsOn": "ubuntu-latest"
    },
    "macos": {
      "numinaIdentity": "NUMINA",
      "provider": "github-hosted",
      "runsOn": "macos-latest"
    },
    "windows": {
      "numinaIdentity": "NUMINA",
      "provider": "github-hosted",
      "runsOn": "windows-latest"
    }
  },
  "roleBindings": {
    "general": "linux",
    "android": "linux",
    "vercel": "linux",
    "quantum": "linux",
    "ios": "macos"
  }
}
