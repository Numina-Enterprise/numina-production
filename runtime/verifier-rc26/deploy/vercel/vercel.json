{
  "framework": null,
  "buildCommand": null,
  "installCommand": null,
  "outputDirectory": null,
  "functions": {"api/index.py": {"maxDuration": 60}},
  "rewrites": [
    {"source": "/api/control/v2/:path*", "destination": "https://numinalabs.xyz/api/control/v2/:path*"},
    {"source": "/.well-known/agent-card.json", "destination": "https://numinalabs.xyz/.well-known/agent-card.json"},
    {"source": "/v2/network/status", "destination": "/api/node-connection"},
    {"source": "/v1/:path*", "destination": "/api/index"},
    {"source": "/healthz", "destination": "/api/index"},
    {"source": "/readyz", "destination": "/api/index"}
  ],
  "redirects": [
    {"source": "/", "destination": "https://numinalabs.xyz/frontier", "permanent": false},
    {"source": "/status", "destination": "https://numinalabs.xyz/build", "permanent": false},
    {"source": "/frontier", "destination": "https://numinalabs.xyz/frontier", "permanent": false},
    {"source": "/control-room", "destination": "https://numinalabs.xyz/control-room", "permanent": false}
  ],
  "headers": [{"source": "/(.*)", "headers": [{"key": "Cache-Control", "value": "no-store"}, {"key": "X-Content-Type-Options", "value": "nosniff"}]}]
}
