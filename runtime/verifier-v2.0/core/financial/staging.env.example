# ==============================================================================
# Numina Financial Core — Staging / Sandbox Environment Configuration Template
# Mode: STRICT READ-ONLY / DRY-RUN (Zero Live Settlement Transfers)
# Do NOT store raw secrets or private keys in this file.
# Secrets resolve dynamically via GCP Secret Manager (secret:// references).
# ==============================================================================

# Core Connector Governance
NUMINA_CONNECTOR_MODE=READ_ONLY
NUMINA_ENABLE_LIVE_SETTLEMENT_WRITES=false
NUMINA_ENABLE_HSM_SIGNING=false

# Google Cloud Project & Region
GCP_PROJECT_ID=project-0317d6c9-e943-409e-83f
GCP_REGION=us-central1

# Bank of America CashPro Sandbox Configuration
BOFA_CASHPRO_CLIENT_ID=sandbox_client_id_placeholder
BOFA_CASHPRO_TOKEN_URL=https://api.developer.bankofamerica.com/oauth/client-credential/v1/token
BOFA_OPERATING_ACCOUNT_ID=bofa_op_sandbox_001
BOFA_RESERVE_ACCOUNT_ID=bofa_res_sandbox_001

# Stripe Test Environment Configuration
STRIPE_ACCOUNT_ID=acct_1UEEPnQdJat0efmT
STRIPE_API_VERSION=2026-09-30.endive
STRIPE_WEBHOOK_URL=https://xyz.numinalabs.app/api/webhooks/stripe

# NCUA Regulatory Reporting Configuration
NCUA_REPORTING_MODE=SIMULATION_EXPORT
NCUA_OMB_CONTROL_NUMBER=3133-0004
NCUA_SUBMISSION_ENABLED=false
